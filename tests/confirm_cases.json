      "score_override": {"agree": 0.94, "reject": 0.02, "takeover": 0.04},
      "notes": "呼应第一轮确认文案(开引擎盖)，明确同意执行。"
    },
    {
      "id": "agree-05", "category": "agree", "first_tool": "car_drive_ESPSwitch",
      "user_reply": "可以", "expected_kev_intent": "agree", "expected_action": "execute",
      "expected_mock_intent": "agree", "kev_needed": false,
