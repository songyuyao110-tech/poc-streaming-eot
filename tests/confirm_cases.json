    {
      "id": "edge-multi-intent-01", "category": "edge", "first_tool": "car_drive_ESPSwitch",
      "user_reply": "别关了先看一下行程", "expected_kev_intent": "takeover", "expected_action": "reroute",
      "expected_mock_intent": null, "kev_needed": true,
      "score_override": {"agree": 0.10, "reject": 0.30, "takeover": 0.60},
      "notes": "多意图合读在一短句：先'别关'(放弃当前确认)+'看行程'(新诉求)。裁决优先级应取更富信息、更靠后的诉求 -> takeover/reroute。mock 落 unknown(关键词互相抵消)，语义需真实 KEV 确认应判 takeover 而非纯 reject。"
    },
    {
      "id": "edge-followup-01", "category": "edge", "first_tool": "car_status_BrakeMaintenanceSet",
      "user_reply": "今天先不弄了", "expected_kev_intent": "reject", "expected_action": "abandon",
