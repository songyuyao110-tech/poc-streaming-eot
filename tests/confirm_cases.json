{
  "_meta": {
    "title": "对话式二次确认 · 二轮回用户回复 -> 预期意图 用例数据集",
    "version": "1.0.1",
    "doc": "docs/test-design-confirmation-v2.md",
    "schema_version": "2026-10",
    "layers": {
      "L1_mock_heuristic": "score_confirm_reply(..., mock=True) 关键词启发式打分 -> judge_confirm_reply。可离线独立跑、确定、可复现，仅作基线，不是产品验收证据。",
      "L2_judge_inject": "手工注入真实校准分(score_override) -> judge_confirm_reply。纯逻辑验收，验证裁决逻辑把'合理真实分'映射到正确分支，不依赖打分通道。",
      "L3_kev_scored": "真实 KEV 三问打分(mock=False, 隧道 :8010) -> judge_confirm_reply。authoritative 语义验收，须对 kev_needed=true 的用例重点看。"
    },
    "output_intents": {
      "agree": "明确同意执行待确认动作 -> execute",
      "reject": "明确拒绝执行待确认动作 -> abandon",
      "takeover": "转移话题/提出新诉求，不再回应本次确认 -> reroute",
      "unknown": "含糊/无法判明 -> 安全优先 abandon，绝不默认执行"
    },
    "field_notes": {
      "expected_kev_intent": "语义权威预期；L2 用（配合 score_override 校验 judge），L3 真实 KEV 的目标。",
      "expected_mock_intent": "null 或分支名。null 表示 mock 关键词启发式无法表达该条真实语义（notes 说明），该条不参与 L1 硬通过；只走 L2/L3。",
      "kev_needed": "true 表示产品验收必须依赖真实 KEV 打分（mock 基线/启发式证据不足），须拉隧道跑 L3。",
      "score_override": "真实 KEV 校准的三问分样本（供 L2 精确校验 judge 把该分映射到 expected_kev_intent）。数值来自 probe/设计基准。"
    }
  },

  "cases": [
