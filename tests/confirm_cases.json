    {
      "id": "agree-08", "category": "agree", "first_tool": "car_drive_ESPSwitch",
      "user_reply": "关掉吧", "expected_kev_intent": "agree", "expected_action": "execute",
      "expected_mock_intent": null, "kev_needed": true,
