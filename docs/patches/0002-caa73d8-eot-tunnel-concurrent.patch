         self.context = {"home_address_configured": True, "company_address_configured": True, "synthetic": True}
         self.events = []
         self.turns = []
@@ -87,13 +90,15 @@ class TurnSession:
         self.turn_done = False
         self.turn_index = 1
         self.segment_closed = False
