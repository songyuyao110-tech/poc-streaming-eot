From caa73d89026793f5385452dc1b3f8226eb795732 Mon Sep 17 00:00:00 2001
From: agent <agent@local>
Date: Fri, 16 Oct 2026 01:16:40 +0800
Subject: [PATCH] poc/streaming-eot: dedicated EOT tunnel + concurrent
 per-prefix EOT, keep speculative cancel

---
 eval/core_pipeline_run.py     | 12 +++--
 eval/streaming_prefix_eval.py | 14 +++++-
 eval/turn_eot.py              |  4 +-
 eval/turn_session.py          | 86 ++++++++++++++++++++++-------------
 4 files changed, 77 insertions(+), 39 deletions(-)

diff --git a/eval/core_pipeline_run.py b/eval/core_pipeline_run.py
index 5389cd0..687ef70 100644
--- a/eval/core_pipeline_run.py
+++ b/eval/core_pipeline_run.py
@@ -29,6 +29,9 @@ from registry import load_registry
 from decisions import Tool, mixed_questions
 
 KEV_BASE = "http://127.0.0.1:8009"
+# EOT judging goes through its own SSH tunnel so it never queues behind tool scoring on KEV_BASE.
+# Both local ports forward to the same remote KEV service (kev-latest @ 106.53.0.235:8009).
+KEV_EOT_BASE = os.environ.get("KEV_EOT_BASE", "http://127.0.0.1:8010")
 KEV_MODEL = "kev-latest"
 # Shared across runs and fallback; retain the tunnel HTTP connection between queries.
 KEV_CLIENT = httpx2.Client(timeout=30.0, trust_env=False, follow_redirects=False,
@@ -41,9 +44,10 @@ KEV_MD_CLIENT = httpx2.Client(timeout=30.0, trust_env=False, follow_redirects=Fa
                               limits=httpx2.Limits(max_connections=2, max_keepalive_connections=2,
                                                   keepalive_expiry=60.0))
 atexit.register(KEV_MD_CLIENT.close)
-# Turn-taking (EOT) judging gets its own single connection so it never competes with tool scoring.
+# Turn-taking (EOT) judging gets its own tunnel + connection pool so it never competes with tool
+# scoring, and concurrent per-prefix EOT calls can be in flight without queueing behind each other.
 KEV_EOT_CLIENT = httpx2.Client(timeout=30.0, trust_env=False, follow_redirects=False,
-                               limits=httpx2.Limits(max_connections=1, max_keepalive_connections=1,
+                               limits=httpx2.Limits(max_connections=4, max_keepalive_connections=4,
                                                    keepalive_expiry=60.0))
 atexit.register(KEV_EOT_CLIENT.close)
 TOOL_THRESHOLD = 0.5
@@ -58,8 +62,8 @@ def unique_object(pairs):
     return result
 
 
-def kev_call(client, state, questions):
-    response = client.post(KEV_BASE + "/v1/systemone", json={"model": KEV_MODEL, "state": state,
+def kev_call(client, state, questions, base=KEV_BASE):
+    response = client.post(base + "/v1/systemone", json={"model": KEV_MODEL, "state": state,
                           "questions": questions, "max_output_tokens": 512})
     if response.status_code != 200:
         raise ValueError("KEV returned non-200")
diff --git a/eval/streaming_prefix_eval.py b/eval/streaming_prefix_eval.py
index 6e28842..5265e6d 100644
--- a/eval/streaming_prefix_eval.py
+++ b/eval/streaming_prefix_eval.py
@@ -113,9 +113,10 @@ def analyse(sentence, events, session, meta, cfg):
     for event in events:
         if event["event"] != "eot_scores":
             continue
-        text = eot_text_by_version.get(event["text_version"], "")
+        text = event.get("text") or eot_text_by_version.get(event["text_version"], "")
         case = prefix_by_text.get(text)
         verdicts.append({"text": text, "label": event["label"], "margin": event["margin"],
+                         "stale": bool(event.get("stale")),
                          "complete": event["complete"], "cut": event["cut"], "wait": event["wait"],
                          "wall_ms": event["wall_ms"], "idx": case["idx"] if case else None,
                          "is_full": case["is_full"] if case else None,
@@ -136,6 +137,7 @@ def analyse(sentence, events, session, meta, cfg):
             "llm_start_latency_ms": summary["t_llm_start_latency_ms"],
             "decision_latency_ms": summary["t_decision_latency_ms"],
             "eot_calls": summary["eot_calls"], "eot_skipped": summary["eot_skipped"],
+            "eot_stale": summary.get("eot_stale"),
             "tool_calls": summary["tool_calls"], "llm_calls": summary["llm_calls"],
             "llm_wasted": summary["llm_wasted"],
             "eot_skips": dict(Counter(event["reason"] for event in events
@@ -214,6 +216,7 @@ def build_report(rows, v0, config, args):
         all_prefixes = sum(row["prefix_count"] for row in subset)
         judged = [v for row in subset for v in row["verdicts"] if v["matched"] and not v["is_full"]]
         judged_strict = [v for v in judged if not v["natural_complete"]]
+        fresh = [v for v in judged if not v.get("stale")]
         judged_natural = [v for v in judged if v["natural_complete"]]
         unmatched = sum(len([v for v in row["verdicts"] if not v["matched"]]) for row in subset)
         prefix_total, prefix_total_all = len(judged_strict), len(judged)
@@ -241,13 +244,20 @@ def build_report(rows, v0, config, args):
             skips.update(row["eot_skips"])
         add(f"| 指标 | 值 |")
         add(f"|---|---|")
-        add(f"| 判停覆盖率（被判过的非整句前缀 / 全部前缀） | {prefix_total_all}/{all_prefixes} = "
+        add(f"| 判停覆盖率（有判停结果的非整句前缀 / 全部前缀） | {prefix_total_all}/{all_prefixes} = "
             f"{(prefix_total_all / all_prefixes * 100 if all_prefixes else 0):.1f}% |")
+        add(f"| 判停可用覆盖率（结果落地时仍是最新文本，非 stale） | {len(fresh)}/{all_prefixes} = "
+            f"{(len(fresh) / all_prefixes * 100 if all_prefixes else 0):.1f}% |")
+        fresh_all = [v for row in subset for v in row["verdicts"] if not v.get("stale")]
+        add(f"| 每句可用（非 stale）判停结果数（含整句，均值） | "
+            f"{len(fresh_all) / len(subset):.2f} |")
         add(f"| ① 前缀误判说完率（按前缀，排除 natural_complete） | {prefix_bad}/{prefix_total} = "
             f"{(prefix_bad / prefix_total * 100 if prefix_total else 0):.2f}% |")
         add(f"| ① 前缀误判说完率（按前缀，不排除） | {prefix_bad_all}/{prefix_total_all} = "
             f"{(prefix_bad_all / prefix_total_all * 100 if prefix_total_all else 0):.2f}% |")
         add(f"| ① 被预标 natural_complete 的前缀中判为 complete | {natural_said_complete}/{len(judged_natural)} |")
+        add(f"| ① 判停结果中判完即过期（stale）的条数 | "
+            f"{sum(1 for v in [v for row in subset for v in row['verdicts']] if v.get('stale'))} |")
         add(f"| ① 未能归因到某个前缀的判停结果（停顿后段内增量文本） | {unmatched} |")
         add(f"| ① 前缀误判说完率（按句，任一前缀误判） | {sentence_bad}/{len(subset)} = "
             f"{(sentence_bad / len(subset) * 100):.2f}% |")
